# Copy to terminal/.env (never commit .env)
SERVER_URL=http://localhost:3000
TERMINAL_PORT=4100
TERMINAL_ID=T-MELB-001
POLLING_PLACE=Melbourne Town Hall

# Must match TERMINAL_ENROLMENT_SECRET in the main .env (needed on first run only)
TERMINAL_ENROLMENT_SECRET=change-me

# AES-256 key for the offline queue (SR-16). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it the same across restarts, or queued ballots cannot be read.
TERMINAL_QUEUE_KEY=

# How often to check in with the Ballot Store while online (ms)
SYNC_INTERVAL_MS=30000
