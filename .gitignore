# Ignore temporary Microsoft Word and pdf files
~$*.docx
*.docx
*.pdf
node_modules/
.env
*.sqlite
# SR-07: receipt signing key (generated automatically)
backend/keys/
terminal/data/
terminal/.env
__pycache__/

# Local test certificates and configuration
backend/test/certs/*-key.pem
backend/test/certs/test-ca.srl

# Local SR-17 test certificates and configuration
backend/test/certs/
